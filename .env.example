NODE_ENV=production
PORT=3000

# Database (gerado pelo Render/Railway ao criar o PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Email (Resend - https://resend.com/api-keys)
EMAIL_USER=seu_email@gmail.com
RESEND_API_KEY=re_sua_api_key_do_resend

# CORS (URL real do frontend na Vercel)
CORS_ORIGIN=https://portfolio-frontend-xyz.vercel.app

# Swagger (URL pública do backend, usada como server no /api-docs)
SWAGGER_URL=https://seu-backend.onrender.com

# Logging
LOG_LEVEL=info
